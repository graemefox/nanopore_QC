// config file for ONT QC Nextflow

manifest.defaultBranch = 'main'

report {
    enabled = true
    overwrite = true
}

conda.enabled = true
conda.createTimeout = '4h'

process {
    conda = "${projectDir}/environment.yml"
}

singularity {
    enabled    = true
    autoMounts = true
    // Cache pulled images so they are not re-downloaded on every run.
    // Override by setting NXF_SINGULARITY_CACHEDIR in your environment.
    cacheDir   = System.getenv("NXF_SINGULARITY_CACHEDIR") ?: "${projectDir}/singularity_cache"
}

params.threads = 16
params.EPI2ME_profile = 'singularity'
